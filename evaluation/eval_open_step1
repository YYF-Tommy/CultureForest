  "Qwen3.5-2B_nonThink"
  "Qwen3.5-4B_nonThink"
  "Qwen3.5-9B_nonThink"
  "Qwen3.5-27B_nonThink"
  "Qwen3.5-0.8B"
  "Qwen3.5-2B"
  "Qwen3.5-4B"
  "Qwen3.5-9B"
  "Qwen3.5-27B"
)

region="All"
category="All"

for model in "${models[@]}"; do
  CUDA_VISIBLE_DEVICES=0,1 python eval_open_step1.py --model "$model" \
    --region "$region" \
    --category "$category" \
    &> ./Eval_Open/step_1_log.out
done
